{
    "name": "eirik-nordgaard-finop",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "next dev",
        "generate:sitemap": "node scripts/generate-sitemap.mjs",
        "check:seo": "node scripts/check-seo.mjs",
        "typecheck": "tsc --noEmit --incremental false",
        "lint": "eslint src netlify scripts tests eslint.config.mjs playwright.config.ts --max-warnings=0",
        "check": "npm run typecheck && npm run lint && npm run check:seo",
        "prebuild": "node scripts/generate-sitemap.mjs && node scripts/check-seo.mjs",
        "build": "next build --webpack",
        "start": "next start",
        "serve:test": "serve out -l 4173 --no-clipboard",
        "test:e2e": "playwright test",
        "audit:lighthouse": "lhci autorun",
        "smoke:production": "node scripts/smoke-production.mjs"
    },
    "dependencies": {
        "@netlify/blobs": "11.0.3",
        "classnames": "^2.5.1",
        "front-matter": "^4.0.2",
        "glob": "^13.0.6",
        "markdown-to-jsx": "^7.7.3",
        "next": "16.3.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwindcss": "^3.4.3"
    },
    "devDependencies": {
        "@base2/pretty-print-object": "^1.0.2",
        "@lhci/cli": "^0.15.1",
        "@netlify/functions": "^6.0.0",
        "@playwright/test": "^1.62.1",
        "@stackbit/cms-git": "^1.0.32",
        "@stackbit/types": "^2.1.10",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.1",
        "eslint-config-next": "^16.3.4",
        "postcss": "^8.5.28",
        "postcss-import": "^15.1.0",
        "prettier": "^3.3.2",
        "serve": "^14.2.6",
        "typescript": "^5.6.2"
    },
    "main": "next.config.js"
}
