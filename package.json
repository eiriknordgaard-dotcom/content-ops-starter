{
    "name": "eirik-nordgaard-finop",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev",
        "generate:sitemap": "node scripts/generate-sitemap.mjs",
        "check:seo": "node scripts/check-seo.mjs",
        "typecheck": "tsc --noEmit --incremental false",
        "lint": "eslint src netlify scripts tests eslint.config.mjs playwright.config.ts --max-warnings=0",
        "check": "npm run typecheck && npm run lint && npm run check:seo && node scripts/check-analytics-bootstrap.mjs && npm run test:monitor-alert",
        "prebuild": "node scripts/generate-sitemap.mjs && node scripts/check-seo.mjs",
        "build": "next build --webpack",
        "start": "next start",
        "serve:test": "serve out -l 4173 --no-clipboard",
        "test:e2e": "playwright test",
        "audit:lighthouse": "lhci autorun",
        "smoke:production": "node scripts/smoke-production.mjs",
        "test:monitor-alert": "node scripts/test-production-monitor-alert.mjs"
    },
    "dependencies": {
        "@netlify/blobs": "11.0.3",
        "classnames": "^2.5.1",
        "front-matter": "^4.0.2",
        "glob": "^13.0.6",
        "markdown-to-jsx": "^7.7.3",
        "next": "16.4.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@base2/pretty-print-object": "^1.0.3",
        "@lhci/cli": "^0.15.1",
        "@netlify/functions": "^6.0.2",
        "@playwright/test": "^1.64.1",
        "@stackbit/cms-git": "^1.0.38",
        "@stackbit/types": "^2.1.10",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "autoprefixer": "^10.6.1",
        "eslint": "^9.39.1",
        "esbuild": "0.28.2",
        "eslint-config-next": "^16.4.2",
        "postcss": "^8.5.30",
        "postcss-import": "^15.1.0",
        "prettier": "^3.9.10",
        "serve": "^14.2.6",
        "tailwindcss": "^3.4.3",
        "typescript": "^5.6.2"
    },
    "overrides": {
        "proxy-addr": "2.0.8",
        "sharp": "0.35.5"
    },
    "main": "next.config.js"
}
